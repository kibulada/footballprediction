# env
.env
.env.local

# bot single-instance lock
.bot.lock

# cache - all generated artifacts (parquet, csv, pkl, logs, tor, odds) except .gitkeep
cache/**
!cache/**/
!cache/**/.gitkeep
# keep calibration + elo for VPS deploy (whitelist, rest of cache stays ignored)
!cache/football/calibration.json
!cache/football/calibration_*.json
!cache/football/elo.json

# large binaries / logs anywhere
*.parquet
*.csv
*.pkl
*.log
pytest_output.txt

# python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/

# editor
.vscode/
.idea/
*.swp
*.swo

# local backups / temp artifacts
*.bak
*.backup
*.before_adjustments
*.new
*.tmp
*.old_params
*.old_*

# oddspapi rolling pool (50 keys)
apikeys.txt
apikeys
oddspapi_keys.txt
cache/football/oddspapi_pool_state.json
cache/football/oddspapi_keys.txt

# claude local settings (personal)
.claude/settings.local.json
